# ==============================================================================
# Production Environment Configuration Template (.env.production.example)
# Copy to `.env.production` on the production host. Never commit `.env.production`.
#
# Generate random 32-byte secrets for production using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ==============================================================================

# ---- Runtime Environment ----
NODE_ENV=production
LOG_LEVEL=info
LOG_PRETTY=false
API_PORT=4000
# 1 when behind Nginx reverse proxy
TRUST_PROXY=1
JSON_BODY_LIMIT=1mb

# ---- Infrastructure Connections (Internal Docker Network) ----
# MongoDB: points to container name 'mongo' on replica set rs0
MONGO_URI=mongodb://mongo:27017/supershop?directConnection=true
# Redis: points to container name 'redis'
REDIS_URL=redis://redis:6379

# ---- Domain Routing & Public URLs ----
# Replace with your actual production domain names
API_PUBLIC_URL=https://api.example.com
STOREFRONT_URL=https://example.com
ADMIN_URL=https://admin.example.com

# Comma-separated list of browser origins permitted for CORS
CORS_ORIGINS=https://example.com,https://admin.example.com

# Optional: Shared root cookie domain for cross-subdomain refresh cookies (e.g. .example.com)
COOKIE_DOMAIN=.example.com

# ---- Cryptographic Secrets (MUST BE UNIQUE, NEVER USE DEV PLACEHOLDERS) ----
# Master key used for AES-256-GCM encryption of payment/SMS/tracking secrets at rest (32 bytes base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# HS256 JWT access and refresh token signing secrets (minimum 32 characters, must differ from each other)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Storage & Local Media Paths ----
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=/app/var/media
MEDIA_PUBLIC_URL=https://api.example.com/media
PRIVATE_FILES_DIR=/app/var/private

# ---- Search & Timezone ----
SEARCH_DRIVER=mongo
TZ_DISPLAY=Asia/Riyadh

# ---- SSL & Certbot Configuration ----
DOMAINS=example.com,admin.example.com,api.example.com
SSL_EMAIL=admin@example.com
