# Copy to `.env` (never commit `.env`). Validated at startup by apps/api core config (P0.2).
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=4000

# ---- Infrastructure (docker-compose.yml) ----
# directConnection=true: talk to the single-node replica set member directly (transactions still work).
MONGO_URI=mongodb://127.0.0.1:27017/supershop?directConnection=true
REDIS_URL=redis://127.0.0.1:6379
MONGO_PORT=27017
REDIS_PORT=6379

# ---- Public URLs / CORS ----
API_PUBLIC_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
# Comma-separated allowlist of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Security (REQUIRED in production; use long random values) ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# 32 random bytes, base64 — master key for AES-256-GCM encryption of stored secrets.
MASTER_KEY=

# ---- Time / locale defaults (admin-editable later via settings) ----
TZ_DISPLAY=Asia/Riyadh
