# Storefront (Next.js). Copy to apps/storefront/.env.local if you need to change defaults.
# Public canonical origin used in canonical/hreflang/OG URLs and the sitemap (no trailing slash).
SITE_URL=http://localhost:3000
# Server-side URL of the API (SSR data fetching + dev proxy for /api/v1/*).
API_INTERNAL_URL=http://localhost:4000
