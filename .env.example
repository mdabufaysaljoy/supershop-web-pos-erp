# Copy to `.env` (never commit `.env`). Validated at startup by apps/api/src/core/config.js —
# the API refuses to start and lists every invalid variable.
# The secrets below are DEVELOPMENT-ONLY placeholders; the API rejects them when NODE_ENV=production.
# Generate real secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ---- Runtime ----
NODE_ENV=development
# fatal|error|warn|info|debug|trace|silent (default: debug in dev, info in prod)
LOG_LEVEL=debug
# Human-readable logs (dev only; needs devDependencies). Default true in development.
LOG_PRETTY=true
API_PORT=4000
# Reverse-proxy hops to trust for the client IP: 0 locally, 1 behind Nginx in production.
TRUST_PROXY=0
JSON_BODY_LIMIT=1mb

# ---- Infrastructure (docker-compose.yml) ----
# directConnection=true: talk to the single-node replica set member directly (transactions still work).
MONGO_URI=mongodb://127.0.0.1:27017/supershop?directConnection=true
REDIS_URL=redis://127.0.0.1:6379
MONGO_PORT=27017
REDIS_PORT=6379

# ---- Public URLs / CORS ----
API_PUBLIC_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
# Comma-separated allowlist of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Refresh-token cookie domain. Leave empty locally / when API and apps share a host.
# Production with api.example.com + example.com + admin.example.com → COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=

# ---- Security (REQUIRED in production; use long random values) ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# 32 random bytes, base64 — master key for AES-256-GCM encryption of stored secrets.
# Back it up: losing it makes every stored encrypted secret unreadable.
MASTER_KEY=XMZAAB+O+vT+wBxxt7EB/Nyf3rrZfNgvvR9Tcuozods=

# ---- Time / locale defaults (admin-editable later via settings) ----
TZ_DISPLAY=Asia/Riyadh
